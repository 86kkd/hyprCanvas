#!/usr/bin/env bash
# Short wrapper for nested-Hyprland manual testing.
#
# Usage:
#   ./scripts/hsctl focus l
#   ./scripts/hsctl move d
#   ./scripts/hsctl move-monitor r
#   ./scripts/hsctl move-workspace d
#   ./scripts/hsctl swap l
#   ./scripts/hsctl size 3
#   ./scripts/hsctl mode col
#   ./scripts/hsctl overview
#   ./scripts/hsctl overview accept
#   ./scripts/hsctl overview cancel
#   ./scripts/hsctl kitty
#   ./scripts/hsctl clients
#
# Instance selection (first match wins):
#   1. -i / --instance SIGNATURE
#   2. $HYPRCANVAS_INSTANCE
#   3. newest Hyprland instance that is not the current session
#   4. newest instance overall
set -euo pipefail

INSTANCE="${HYPRCANVAS_INSTANCE:-}"

die() {
    printf 'hsctl: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
hsctl — short hyprctl wrapper for nested hyprcanvas tests

Commands:
  focus <l|r|u|d|...>     hl.plugin.canvas.move_focus
  move  <l|r|u|d|...>     hl.plugin.canvas.move_window
  move-workspace <l|r|u|d> move window to adjacent canvas and follow
  move-monitor <l|r|u|d>  move window directly to adjacent monitor and follow
  swap  <l|r|u|d|...>     hl.plugin.canvas.swap_window (adjacent stack)
  monitor <l|r|u|d>      focus monitor / select canvas in overview
  workspace <l|r|u|d|1-10>
                          switch canvas workspace (alias: canvas)
  marks add <name>        mark the focused window
  marks visit <name>      focus a marked window
  marks delete <name>     delete a mark
  marks reset             clear all marks (alias: mark)
  size  <1-8>             hl.plugin.canvas.set_window_size
  mode  <row|col>         hl.plugin.canvas.set_mode
  fullscreen              hl.plugin.canvas.toggle_fullscreen
  overview                open overview, or accept if already open
  overview accept         accept selection and leave overview
  overview cancel         leave overview without accepting
  exec  <cmd...>          dispatch exec in the nested instance
  kitty|foot|alacritty|ghostty  shorthand for exec <term>
  clients|monitors|activeworkspace|activewindow|workspaces
                          hyprctl -j queries
  plugins                 hyprctl plugin list
  eval  <lua...>          raw hyprctl eval
  raw   <hyprctl args...> pass through to hyprctl -i <instance>
  which                   print the chosen instance signature
  exit                    exit the nested instance
  help                    this text

Directions also accept left/right/up/down/dn.
Focus/move additionally accept begin/b/beginning and end/e.

Options:
  -i, --instance SIG      target a specific Hyprland instance
  -h, --help

Environment:
  HYPRCANVAS_INSTANCE   default instance signature
EOF
}

pick_instance() {
    if [[ -n "$INSTANCE" ]]; then
        printf '%s\n' "$INSTANCE"
        return
    fi

    command -v jq >/dev/null 2>&1 || die "jq is required to auto-pick an instance; pass -i SIG"

    local outer="${HYPRLAND_INSTANCE_SIGNATURE:-}"
    local chosen
    chosen="$(hyprctl instances -j | jq -r --arg outer "$outer" '
        (map(select(.instance != $outer)) | sort_by(.time) | reverse | .[0].instance)
        // (sort_by(.time) | reverse | .[0].instance)
        // empty
    ')"
    [[ -n "$chosen" ]] || die "no Hyprland instances found"
    printf '%s\n' "$chosen"
}

run_hypr() {
    local instance
    instance="$(pick_instance)"
    hyprctl -i "$instance" "$@"
}

run_eval() {
    run_hypr eval "$1"
}

canvas() {
    local fn="$1"
    shift
    if [[ $# -eq 0 ]]; then
        run_eval "hl.plugin.canvas.${fn}()"
    else
        # Encode control characters as well as quotes without evaluating input.
        local arg
        arg="$(lua_string "$1")"
        run_eval "hl.plugin.canvas.${fn}(${arg})"
    fi
}

lua_string() {
    local arg="$1"
    arg="${arg//\\/\\\\}"
    arg="${arg//\"/\\\"}"
    arg="${arg//$'\n'/\\n}"
    arg="${arg//$'\r'/\\r}"
    arg="${arg//$'\t'/\\t}"
    printf '"%s"' "$arg"
}

one_arg() {
    [[ $# -eq 1 ]] || die "$cmd needs exactly one argument (try: hsctl help)"
}

cardinal_direction() {
    case "$1" in
        l|r|u|d|left|right|up|down|dn) ;;
        *) die "invalid direction: $1 (use l/r/u/d)" ;;
    esac
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -i|--instance)
            [[ $# -ge 2 ]] || die "$1 needs an instance signature"
            INSTANCE="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            die "unknown option: $1"
            ;;
        *)
            break
            ;;
    esac
done

[[ $# -gt 0 ]] || { usage; exit 0; }

cmd="$1"
shift

case "$cmd" in
    help)
        usage
        ;;
    which)
        pick_instance
        ;;
    focus)
        [[ $# -ge 1 ]] || die "focus needs a direction"
        canvas move_focus "$1"
        ;;
    move)
        [[ $# -ge 1 ]] || die "move needs a direction"
        canvas move_window "$1"
        ;;
    move-monitor)
        one_arg "$@"
        cardinal_direction "$1"
        canvas move_window_to_monitor "$1"
        ;;
    move-workspace)
        one_arg "$@"
        cardinal_direction "$1"
        canvas move_window_to_workspace "$1"
        ;;
    swap)
        [[ $# -ge 1 ]] || die "swap needs a direction"
        canvas swap_window "$1"
        ;;
    monitor|focusmonitor)
        one_arg "$@"
        cardinal_direction "$1"
        canvas focus_monitor "$1"
        ;;
    workspace|canvas)
        one_arg "$@"
        case "$1" in
            [1-9]|10) ;;
            *) cardinal_direction "$1" ;;
        esac
        canvas switch_workspace "$1"
        ;;
    marks|mark)
        [[ $# -ge 1 ]] || die "marks needs add, visit, delete, or reset"
        action="$1"
        shift
        case "$action" in
            add|visit|delete)
                one_arg "$@"
                [[ -n "$1" ]] || die "mark name must not be empty"
                canvas "marks_${action}" "$1"
                ;;
            reset)
                [[ $# -eq 0 ]] || die "marks reset takes no arguments"
                canvas marks_reset
                ;;
            *) die "unknown marks action: $action" ;;
        esac
        ;;
    size)
        one_arg "$@"
        [[ "$1" =~ ^[1-8]$ ]] || die "size needs an integer 1-8"
        run_eval "hl.plugin.canvas.set_window_size($1)"
        ;;
    mode)
        one_arg "$@"
        [[ "$1" == row || "$1" == col ]] || die "mode needs row or col"
        canvas set_mode "$1"
        ;;
    fullscreen)
        canvas toggle_fullscreen
        ;;
    overview|ov)
        [[ $# -le 1 ]] || die "overview takes at most one action"
        case "${1:-}" in
            "")
                canvas toggle_overview
                ;;
            accept|confirm|enter)
                canvas toggle_overview accept
                ;;
            cancel|abort|close)
                canvas cancel_overview
                ;;
            *)
                die "overview accepts accept or cancel"
                ;;
        esac
        ;;
    exec)
        [[ $# -ge 1 ]] || die "exec needs a command"
        # Prefer Lua exec so it matches the rest of the 0.57 test flow.
        joined="$*"
        joined="${joined//\\/\\\\}"
        joined="${joined//\"/\\\"}"
        run_eval "hl.dispatch(hl.dsp.exec_cmd(\"${joined}\"))"
        ;;
    kitty|foot|alacritty|ghostty)
        run_eval "hl.dispatch(hl.dsp.exec_cmd(\"${cmd}\"))"
        ;;
    clients|monitors|activeworkspace|activewindow|workspaces)
        run_hypr "$cmd" -j
        ;;
    plugins)
        run_hypr plugin list
        ;;
    eval)
        [[ $# -ge 1 ]] || die "eval needs a Lua expression"
        run_eval "$*"
        ;;
    raw)
        [[ $# -ge 1 ]] || die "raw needs hyprctl arguments"
        run_hypr "$@"
        ;;
    exit)
        run_eval 'hl.dispatch(hl.dsp.exit())'
        ;;
    *)
        die "unknown command: $cmd (try: hsctl help)"
        ;;
esac
